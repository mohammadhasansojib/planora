

model BkashToken {
    id                      String @id @default(uuid()) @db.Uuid
    environment             PaymentGatewayEnvironment @default(SANDBOX)
    idToken                 String
    idTokenExpiresAt        DateTime
    refreshToken            String
    refreshTokenExpiresAt   DateTime
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt
}
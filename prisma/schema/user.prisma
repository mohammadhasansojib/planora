

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations OrganizationMember[]
  teams         TeamMember[]
  projects      ProjectMember[]
  comments      Comment[]
  attachments   Attachment[]
  activities    Activity[]
  payment       Payment[]
}
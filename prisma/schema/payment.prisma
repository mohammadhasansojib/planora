

model Payment {
    id              String @id @default(uuid()) @db.Uuid
    userId          String @db.Uuid
    User   User @relation(fields: [userId], references: [id])
    transactionId   String
    paymentId       String
    amount          Decimal
    status          PaymentStatus
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}